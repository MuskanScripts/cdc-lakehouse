     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(lakehouse_kafka_lag_messages)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
