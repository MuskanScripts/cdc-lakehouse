    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 100000000.0
       },
       {
        "color": "red",
        "value": 1000000000.0
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
