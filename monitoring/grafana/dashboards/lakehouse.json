      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5000
       },
       {
        "color": "red",
        "value": 20000
       }
      ]
     }
    },
    "overrides": []
   }
  },
