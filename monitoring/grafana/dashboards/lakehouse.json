  {
   "id": 6,
   "type": "stat",
   "title": "Replication slot lag",
   "description": "WAL Postgres retains for Debezium. max_slot_wal_keep_size is 2 GB (ADR-008).",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
